#define F_CPU 10000000UL

#include <avr/io.h>
#include <util/delay.h>


#define leftsens PD4
#define rightsens PD5



int main(void)
{
	DDRC |= (1<<PC0)|(1<<PC2) |(1<<PC1)|(1<<PC3) ; // motors output
	// Added parentheses around the OR bitwise operation so both pins are cleared.
	DDRD &= ~((1<<PD4)|(1<<PD5)); // sensors input
	
	// 1. Set PB1 (OC1A) and PB2 (OC1B) as outputs
	DDRB |= (1 << PB1) | (1 << PB2);

	// 2. Timer 1 Configuration: Fast PWM, 8-bit (Mode 5)
	TCCR1A = (1 << COM1A1) | (1 << COM1B1) | (1 << WGM10);

	// 3. Set Prescaler to 64 and finish Mode 5 setup
	TCCR1B = (1 << WGM12) | (1 << CS11) | (1 << CS10);

	// 4. Initialize speeds to 0 (motors off)
	OCR1A = 80; // Duty cycle for Left Motor ENA (PB1)
	OCR1B = 80; // Duty cycle for Right Motor ENB (PB2)

	while (1)
	{
		
		// Read the sensor states once per loop to make the code cleaner
		uint8_t left_state = PIND & (1<<leftsens);
		uint8_t right_state = PIND & (1<<rightsens);
		PORTC |= (1<<PC0) | (1<<PC2);
		PORTC &= ~((1<<PC1) | (1<<PC3));

		if ((left_state==0) && (right_state==0)) {
			// BOTH LOW (0,0) -> Move Forward
			OCR1A = 80;
			OCR1B = 80;
		}
		else if (left_state && right_state) {
			// BOTH HIGH (1,1) -> move back)
			// It is usually safer to stop the motors by setting all to LOW
			OCR1A = 80;
			OCR1B = 80;
			PORTC |= ((1<<PC1) | (1<<PC3));
			PORTC &= ~(1<<PC0) | (1<<PC2);
		}
		else if ((left_state==0) && right_state) {
			// LEFT LOW (0), RIGHT HIGH (1) -> Turn Right
			_delay_ms(100);
			OCR1A = 80;
			OCR1B = 0;
		}
		else if (left_state && (right_state==0)) {
			// LEFT HIGH (1), RIGHT LOW (0) -> Turn Left
			_delay_ms(100);
			OCR1A = 0;
			OCR1B = 80;
		}
	}
}

